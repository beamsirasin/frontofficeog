# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก .gitignore ไว้แล้ว ไม่ขึ้น git)
# หลัง แก้ไข .env ต้อง restart server ถึงจะมีผล

# ใช้สร้างบัญชีเจ้าของร้าน "ครั้งแรกเท่านั้น" ตอนยังไม่มีผู้ใช้ในระบบเลย (เก็บใน DB แบบแฮชแล้ว)
# เปลี่ยนค่านี้ภายหลังจะไม่มีผลกับบัญชีที่ถูกสร้างไปแล้ว (ยังไม่มีหน้าจัดการบัญชี/เปลี่ยนรหัสผ่านในเฟสนี้)
# ถ้าไม่ตั้งและ DB ยังไม่มีผู้ใช้เลย ระบบจะไม่สร้างบัญชีเริ่มต้นให้ (ต้องตั้งก่อนถึงจะ login ได้)
ADMIN_USER=admin
ADMIN_PASS=changeme

# พอร์ตที่เซิร์ฟเวอร์รัน (ไม่ใส่ = 3000)
PORT=3000

# อายุ session หลัง login (ชั่วโมง, ไม่ใส่ = 12)
SESSION_TTL_HOURS=12

# ตั้งเป็น true ตอน deploy จริงบน HTTPS (ดู MIGRATION.md) — cookie จะส่งเฉพาะผ่าน HTTPS เท่านั้น
# ปล่อยว่าง/false ตอนพัฒนาบนเครื่องผ่าน http://localhost
COOKIE_SECURE=false

# (Phase 6C) ตั้งเป็น true เฉพาะตอน deploy จริงหลัง nginx ตามที่ MIGRATION.md อธิบายไว้เท่านั้น (proxy_set_header X-Forwarded-For ...)
# มีผลต่อ rate limiting ทุกจุด (login, /api/table-session, /api/queue/cancel-by-token, send_order) — เชื่อ IP จาก header นี้เฉพาะ hop เดียว (nginx)
# ปล่อยว่าง/false ตอนพัฒนา/LAN staging/เทสต์ (ไม่มี reverse proxy อยู่หน้าแอปเลย) — ไม่งั้นใครก็ปลอม IP ตัวเองผ่าน header นี้ตรงๆ ได้ทันที
# NODE_ENV=production จะเปิดให้อัตโนมัติแม้ไม่ได้ตั้งค่านี้ไว้ก็ตาม
TRUST_PROXY=false
